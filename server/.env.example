# Server
PORT=4000
# Comma-separated origins allowed to call the REST API (web app).
CORS_ORIGINS=http://localhost:3000

# Supabase (Postgres) - session pooler (port 5432).
# Do NOT use the transaction pooler on 6543 -- no prepared statements.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never ship this to the web app.
SUPABASE_SECRET_KEY=

# TLS. Supabase needs it; set DB_SSL=false only for a local Postgres.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Alternative to DATABASE_URL: discrete fields (local Postgres, etc.)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres

# Legacy Supabase JWT secret (Project Settings -> API -> JWT secret).
# Optional: only used to verify HS256 access tokens locally. Tokens signed
# with the newer asymmetric keys are verified against Supabase's JWKS.
SUPABASE_JWT_SECRET=

# Location updates: minimum ms between stored points per user.
LOCATION_MIN_INTERVAL_MS=1000

# --- Scaling -----------------------------------------------------------------
# Optional. Set to fan out events across several server instances (Redis pub/sub).
REDIS_URL=

# --- Limits ------------------------------------------------------------------
WS_RATE_PER_SEC=10
WS_RATE_BURST=20
HTTP_USER_RATE_PER_MIN=240
HTTP_PUBLIC_RATE_PER_MIN=30

# --- Retention ---------------------------------------------------------------
RETENTION_ENABLED=true
RETENTION_KEEP_DAYS=30
RETENTION_DOWNSAMPLE_AFTER_DAYS=7

# --- Demo mode ---------------------------------------------------------------
DEMO_ENABLED=true
DEMO_SESSION_MINUTES=30

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info
# When set, GET /metrics requires `Authorization: Bearer <METRICS_TOKEN>`.
METRICS_TOKEN=
