# Public values only -- these are bundled into the browser app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
# Google OAuth client ID (the same one entered in Supabase). When set, Google
# sign-in happens on this site, so Google shows our domain, not Supabase's.
VITE_GOOGLE_CLIENT_ID=
