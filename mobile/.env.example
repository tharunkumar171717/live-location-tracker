# Public values only -- EXPO_PUBLIC_* is bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Android emulator reaches your Mac's localhost at 10.0.2.2.
# On a physical phone use your Mac's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:4000/ws
# Build-time only (not EXPO_PUBLIC): Google Maps SDK for Android key.
GOOGLE_MAPS_ANDROID_API_KEY=
